{
  "$defs": {
    "Admission": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "student_id": {
          "title": "Student Id",
          "type": "string"
        },
        "student_name": {
          "title": "Student Name",
          "type": "string"
        },
        "apaar_id_masked": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Masked as XXXX-XXXX-1234",
          "title": "Apaar Id Masked"
        },
        "provisional_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provisional Id"
        },
        "apaar_opt_out": {
          "default": false,
          "title": "Apaar Opt Out",
          "type": "boolean"
        },
        "institution_id": {
          "title": "Institution Id",
          "type": "string"
        },
        "programme_id": {
          "title": "Programme Id",
          "type": "string"
        },
        "programme_code": {
          "title": "Programme Code",
          "type": "string"
        },
        "academic_year": {
          "title": "Academic Year",
          "type": "string"
        },
        "seat_pool": {
          "enum": [
            "regular",
            "tfw",
            "fn_oci_pio",
            "nri"
          ],
          "title": "Seat Pool",
          "type": "string"
        },
        "admission_mode": {
          "enum": [
            "cap",
            "management",
            "lateral",
            "spot"
          ],
          "title": "Admission Mode",
          "type": "string"
        },
        "admission_date": {
          "format": "date",
          "title": "Admission Date",
          "type": "string"
        },
        "qualifying_exam_pct": {
          "title": "Qualifying Exam Pct",
          "type": "number"
        },
        "status": {
          "enum": [
            "submitted",
            "student_confirmed",
            "student_disputed",
            "no_response",
            "withdrawn"
          ],
          "title": "Status",
          "type": "string"
        },
        "batch_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Batch Id"
        }
      },
      "required": [
        "id",
        "student_id",
        "student_name",
        "institution_id",
        "programme_id",
        "programme_code",
        "academic_year",
        "seat_pool",
        "admission_mode",
        "admission_date",
        "qualifying_exam_pct",
        "status"
      ],
      "title": "Admission",
      "type": "object"
    },
    "StudentProfile": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "full_name": {
          "title": "Full Name",
          "type": "string"
        },
        "apaar_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Masked as XXXX-XXXX-1234; never the full ID",
          "title": "Apaar Id"
        },
        "apaar_id_masked": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Apaar Id Masked"
        },
        "provisional_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provisional Id"
        },
        "opted_out": {
          "title": "Opted Out",
          "type": "boolean"
        },
        "dob": {
          "format": "date",
          "title": "Dob",
          "type": "string"
        },
        "telegram_linked": {
          "title": "Telegram Linked",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "full_name",
        "apaar_id",
        "opted_out",
        "dob",
        "telegram_linked"
      ],
      "title": "StudentProfile",
      "type": "object"
    }
  },
  "properties": {
    "student": {
      "$ref": "#/$defs/StudentProfile"
    },
    "admissions": {
      "items": {
        "$ref": "#/$defs/Admission"
      },
      "title": "Admissions",
      "type": "array"
    }
  },
  "required": [
    "student",
    "admissions"
  ],
  "title": "StudentRecords",
  "type": "object"
}
