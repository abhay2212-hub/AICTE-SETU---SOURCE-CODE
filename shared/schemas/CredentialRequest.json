{
  "properties": {
    "claims": {
      "anyOf": [
        {
          "items": {
            "enum": [
              "enrolment_status",
              "institution",
              "programme",
              "academic_year"
            ],
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Claims to share (at least one)",
      "title": "Claims"
    },
    "audience": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Verifier the credential is for, e.g. 'Acme Infotech'",
      "title": "Audience"
    },
    "expiry": {
      "anyOf": [
        {
          "enum": [
            "15m",
            "1d",
            "7d"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expiry"
    },
    "admission_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Admission to describe; default the student's most recent active one",
      "title": "Admission Id"
    },
    "verifier_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Deprecated: use audience",
      "title": "Verifier Id"
    },
    "purpose": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Deprecated: ignored",
      "title": "Purpose"
    },
    "fields": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Deprecated: use claims",
      "title": "Fields"
    },
    "expires_in_days": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Deprecated: use expiry (1 or 7)",
      "title": "Expires In Days"
    }
  },
  "title": "CredentialRequest",
  "type": "object"
}
