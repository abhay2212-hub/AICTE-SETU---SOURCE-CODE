  "description": "One page of batches, newest first. total counts every match, not just this page.",
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/Batch"
      },
      "title": "Items",
      "type": "array"
    },
    "total": {
      "title": "Total",
      "type": "integer"
    },
    "limit": {
      "title": "Limit",
      "type": "integer"
    },
    "offset": {
      "title": "Offset",
      "type": "integer"
    }
  },
  "required": [
    "items",
    "total",
    "limit",
    "offset"
  ],
  "title": "BatchList",
  "type": "object"
}
