{
  "$defs": {
    "Batch": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "institution_id": {
          "title": "Institution Id",
          "type": "string"
        },
        "uploaded_by": {
          "title": "Uploaded By",
          "type": "string"
        },
        "file_name": {
          "title": "File Name",
          "type": "string"
        },
        "file_hash": {
          "title": "File Hash",
          "type": "string"
        },
        "status": {
          "enum": [
            "uploaded",
            "mapped",
            "validated",
            "committed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "counts": {
          "$ref": "#/$defs/BatchCounts"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "parent_batch_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set on a correction batch: the batch whose rejected rows it fixes",
          "title": "Parent Batch Id"
        }
      },
      "required": [
        "id",
        "institution_id",
        "uploaded_by",
        "file_name",
        "file_hash",
        "status",
        "counts",
        "created_at"
      ],
      "title": "Batch",
      "type": "object"
    },
    "BatchCounts": {
      "properties": {
        "rows_total": {
          "default": 0,
          "title": "Rows Total",
          "type": "integer"
        },
        "errors": {
          "default": 0,
          "title": "Errors",
          "type": "integer"
        },
        "warnings": {
          "default": 0,
          "title": "Warnings",
          "type": "integer"
        },
        "review": {
          "default": 0,
          "title": "Review",
          "type": "integer"
        },
        "info": {
          "default": 0,
          "title": "Info",
          "type": "integer"
        }
      },
      "title": "BatchCounts",
      "type": "object"
    }
