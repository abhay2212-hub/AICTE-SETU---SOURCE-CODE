{
  "properties": {
    "valid": {
      "title": "Valid",
      "type": "boolean"
    },
    "reason": {
      "anyOf": [
        {
          "enum": [
            "malformed",
            "bad_signature",
            "unsupported",
            "expired",
            "revoked"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "claims": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Claims"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    }
  },
  "required": [
    "valid"
  ],
  "title": "Verification",
  "type": "object"
}
