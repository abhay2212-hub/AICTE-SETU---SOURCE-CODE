        "institution_id": {
          "title": "Institution Id",
          "type": "string"
        },
        "student_name": {
          "title": "Student Name",
          "type": "string"
        },
        "dob": {
          "title": "Dob",
          "type": "string"
        },
        "father_name": {
          "default": "",
          "title": "Father Name",
          "type": "string"
        },
        "mother_name": {
          "default": "",
          "title": "Mother Name",
          "type": "string"
        },
        "apaar_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
